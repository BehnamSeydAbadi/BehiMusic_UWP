<Application
    x:Class="BehiMusic_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BehiMusic_UWP"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BehiBackgroundColor">#FF101116</Color>
            <Color x:Key="BehiSurfaceColor">#FF1A1B22</Color>
            <Color x:Key="BehiSurfaceRaisedColor">#FF24252E</Color>
            <Color x:Key="BehiPrimaryColor">#FFC9B9FF</Color>
            <Color x:Key="BehiPrimaryContainerColor">#FF40375C</Color>
            <Color x:Key="BehiTextColor">#FFF4F1FA</Color>
            <Color x:Key="BehiMutedTextColor">#FFAAA7B2</Color>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource BehiBackgroundColor}"/>
            <SolidColorBrush x:Key="BehiSurfaceBrush" Color="{StaticResource BehiSurfaceColor}"/>
            <SolidColorBrush x:Key="BehiSurfaceRaisedBrush" Color="{StaticResource BehiSurfaceRaisedColor}"/>
            <SolidColorBrush x:Key="BehiPrimaryBrush" Color="{StaticResource BehiPrimaryColor}"/>
            <SolidColorBrush x:Key="BehiPrimaryContainerBrush" Color="{StaticResource BehiPrimaryContainerColor}"/>
            <SolidColorBrush x:Key="BehiTextBrush" Color="{StaticResource BehiTextColor}"/>
            <SolidColorBrush x:Key="BehiMutedTextBrush" Color="{StaticResource BehiMutedTextColor}"/>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BehiTextBrush}"/></Style>
            <Style x:Key="BehiIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BehiTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="IconButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BehiNavButtonStyle" TargetType="Button" BasedOn="{StaticResource BehiIconButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="Padding" Value="2,5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
