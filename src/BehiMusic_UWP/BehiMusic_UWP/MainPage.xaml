<Page x:Class="BehiMusic_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BehiMusic_UWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FlatListItem" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
        <Style x:Key="FlatGridItem" TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
        <DataTemplate x:Key="SongTemplate">
            <Grid Padding="12,7" MinHeight="66">
                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="8" Background="{StaticResource BehiPrimaryContainerBrush}"><Grid><FontIcon Glyph="&#xE93C;" FontSize="21" Foreground="{StaticResource BehiPrimaryBrush}"/><Image Source="{Binding Artwork}" Stretch="Uniform"/></Grid></Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayArtist}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Click="PlayNext_Click" Style="{StaticResource BehiIconButtonStyle}" ToolTipService.ToolTip="Add to playing queue"><FontIcon Glyph="&#xE710;" FontSize="15"/></Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="QueueSongTemplate">
            <Grid Padding="8,7" MinHeight="66">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource BehiPrimaryContainerBrush}"><Grid><FontIcon Glyph="&#xE93C;" FontSize="20" Foreground="{StaticResource BehiPrimaryBrush}"/><Image Source="{Binding Artwork}" Stretch="Uniform"/></Grid></Border>
                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="{StaticResource BehiMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
                <Button Grid.Column="2" Width="44" HorizontalAlignment="Right" Click="QueueItemRemove_Click" Style="{StaticResource BehiIconButtonStyle}" ToolTipService.ToolTip="Remove from queue"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactSongTemplate">
            <Grid Width="132" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="12" Background="{StaticResource BehiPrimaryContainerBrush}"><Grid><FontIcon Glyph="&#xE93C;" FontSize="38" Foreground="{StaticResource BehiPrimaryBrush}"/><Image Source="{Binding Artwork}" Stretch="Uniform"/></Grid></Border>
                <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/><TextBlock Grid.Row="2" Text="{Binding DisplayArtist}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate">
            <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Width="{Binding CoverSize}" Height="{Binding CoverSize}" HorizontalAlignment="Center" CornerRadius="12" Background="{StaticResource BehiSurfaceRaisedBrush}"><Grid><Ellipse Width="64" Height="64" Fill="{StaticResource BehiPrimaryContainerBrush}"/><FontIcon Glyph="&#xE93C;" FontSize="28" Foreground="{StaticResource BehiPrimaryBrush}"/><Image Source="{Binding Artwork}" Stretch="Uniform"/></Grid></Border>
                <StackPanel Grid.Row="1" Margin="2,8,2,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" Margin="0,2,0,0"/></StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootLayout">
        <SplitView x:Name="QueueSplitView" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="330" PaneClosed="QueueSplitView_PaneClosed">
            <SplitView.Pane>
                <Grid Background="{StaticResource BehiSurfaceBrush}" Padding="16,20,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,0,0,12"><TextBlock Text="Playing queue" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Click="CloseQueue_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE711;"/></Button></Grid>
                    <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueSongTemplate}" ItemContainerStyle="{StaticResource FlatListItem}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="QueueList_ItemClick" CanDragItems="True" CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled" DragItemsStarting="QueueList_DragItemsStarting" DragItemsCompleted="QueueList_DragItemsCompleted"/>
                </Grid>
            </SplitView.Pane>
            <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <!-- Reclaim the unused Pivot header while retaining a phone-safe inset
                         below the system status bar. Navigation is provided by the bottom bar. -->
                    <Pivot x:Name="LibraryPivot" Margin="0,-40,0,0" SelectionChanged="LibraryPivot_SelectionChanged"><Pivot.HeaderTemplate><DataTemplate><Grid Width="0" Height="0"/></DataTemplate></Pivot.HeaderTemplate>
                        <PivotItem Header="Home"><ScrollViewer><StackPanel Padding="16,2,16,24">
                            <Border Background="{StaticResource BehiSurfaceRaisedBrush}" CornerRadius="22" Margin="0,0,0,20"><AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search songs, artists and albums" Background="Transparent" BorderThickness="0" Padding="14,10" TextChanged="SearchBox_TextChanged" SuggestionChosen="SearchBox_SuggestionChosen" QuerySubmitted="SearchBox_QuerySubmitted"/></Border>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ViewModel.ScanProgress}" Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4,-14,4,14" Foreground="{StaticResource BehiPrimaryBrush}"/>
                            <TextBlock Text="Quick picks" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,12"/>
                            <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BehiPrimaryContainerBrush}"><Button Tag="Songs" Click="QuickPick_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE8FD;" Foreground="{StaticResource BehiPrimaryBrush}"/></Button></Border><TextBlock Text="Songs" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BehiSurfaceRaisedBrush}"><Button Tag="Albums" Click="QuickPick_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE93C;"/></Button></Border><TextBlock Text="Albums" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BehiSurfaceRaisedBrush}"><Button Tag="Folders" Click="QuickPick_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE8B7;"/></Button></Border><TextBlock Text="Folders" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="3"><Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BehiSurfaceRaisedBrush}"><Button Tag="Shuffle" Click="QuickPick_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE8B1;"/></Button></Border><TextBlock Text="Shuffle" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                            <Grid Margin="2,0,0,10"><TextBlock Text="Recently added" FontSize="20" FontWeight="SemiBold"/><Button Content="See all" HorizontalAlignment="Right" Tag="Songs" Click="QuickPick_Click" Foreground="{StaticResource BehiPrimaryBrush}" Background="Transparent" BorderThickness="0"/></Grid>
                            <ListView x:Name="RecentSongsList" ItemsSource="{Binding ViewModel.RecentlyAdded}" ItemTemplate="{StaticResource CompactSongTemplate}" IsItemClickEnabled="True" ItemClick="SongsList_ItemClick" SelectionMode="None" Height="172" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView>
                            <TextBlock Text="Albums" FontSize="20" FontWeight="SemiBold" Margin="2,20,0,8"/><GridView x:Name="HomeAlbumsGrid" ItemsSource="{Binding ViewModel.HomeAlbums}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled"/>
                        </StackPanel></ScrollViewer></PivotItem>
                        <PivotItem Header="Songs"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Songs" FontSize="24" FontWeight="SemiBold" Margin="18,8,18,10"/><ListView x:Name="SongsList" Grid.Row="1" ItemsSource="{Binding ViewModel.Songs}" ItemTemplate="{StaticResource SongTemplate}" ItemContainerStyle="{StaticResource FlatListItem}" IsItemClickEnabled="True" ItemClick="SongsList_ItemClick" SelectionMode="None"/></Grid></PivotItem>
                        <PivotItem Header="Albums"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Albums" FontSize="24" FontWeight="SemiBold" Margin="18,8,18,10"/><GridView x:Name="AlbumsGrid" Grid.Row="1" ItemsSource="{Binding ViewModel.Albums}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded"/></Grid></PivotItem>
                        <PivotItem Header="Artists"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Artists" FontSize="24" FontWeight="SemiBold" Margin="18,8,18,10"/><GridView x:Name="ArtistsGrid" Grid.Row="1" ItemsSource="{Binding ViewModel.Artists}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded"/></Grid></PivotItem>
                        <PivotItem Header="More"><ScrollViewer><StackPanel Padding="16,8,16,24">
                            <Grid Margin="2,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Your music" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.Status}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button Grid.Column="1" Click="Scan_Click" Style="{StaticResource BehiIconButtonStyle}" ToolTipService.ToolTip="Scan MP3 library"><FontIcon Glyph="&#xE895;"/></Button>
                                <Button Grid.Column="2" Style="{StaticResource BehiIconButtonStyle}" ToolTipService.ToolTip="Library settings"><FontIcon Glyph="&#xE713;"/><Button.Flyout><Flyout Placement="Bottom"><StackPanel MinWidth="230"><TextBlock Text="Library settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox x:Name="SortCombo" Header="Sort songs" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Title"/><ComboBoxItem Content="Artist"/><ComboBoxItem Content="Album"/><ComboBoxItem Content="Year"/><ComboBoxItem Content="Date added"/><ComboBoxItem Content="Duration"/></ComboBox><ToggleButton x:Name="SortDirectionButton" Content="Ascending" IsChecked="True" Checked="SortDirection_Changed" Unchecked="SortDirection_Changed" HorizontalAlignment="Stretch" Margin="0,10,0,0"/><ComboBox x:Name="GridDensityCombo" Header="Grid columns" SelectedIndex="1" SelectionChanged="GridDensity_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,10,0,0"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></StackPanel></Flyout></Button.Flyout></Button>
                            </Grid>
                            <TextBlock Text="Browse more" FontSize="24" FontWeight="SemiBold" Margin="2,0,0,12"/><TextBlock Text="Album artists" FontSize="18" FontWeight="SemiBold" Margin="2,8,0,6"/><GridView x:Name="AlbumArtistsGrid" ItemsSource="{Binding ViewModel.AlbumArtists}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded" MaxHeight="350"/><TextBlock Text="Genres" FontSize="18" FontWeight="SemiBold" Margin="2,22,0,6"/><GridView x:Name="GenresGrid" ItemsSource="{Binding ViewModel.Genres}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded" MaxHeight="350"/><TextBlock Text="Folders" FontSize="18" FontWeight="SemiBold" Margin="2,22,0,6"/><GridView x:Name="FoldersGrid" ItemsSource="{Binding ViewModel.Folders}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded" MaxHeight="350"/><TextBlock Text="Release types" FontSize="18" FontWeight="SemiBold" Margin="2,22,0,6"/><GridView x:Name="ReleaseTypesGrid" ItemsSource="{Binding ViewModel.ReleaseTypes}" ItemTemplate="{StaticResource GroupTemplate}" ItemContainerStyle="{StaticResource FlatGridItem}" IsItemClickEnabled="True" ItemClick="Group_ItemClick" Loaded="GroupGrid_Loaded" MaxHeight="350"/>
                        </StackPanel></ScrollViewer></PivotItem>
                    </Pivot>
                </Grid>
                <Border x:Name="MiniPlayerBar" Grid.Row="1" Margin="10,4,10,5" Background="{StaticResource BehiSurfaceRaisedBrush}" CornerRadius="14" MinHeight="68" Tapped="MiniPlayerBar_Tapped"><Grid Padding="10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="9" Background="{StaticResource BehiPrimaryContainerBrush}"><Grid><FontIcon Glyph="&#xE93C;" Foreground="{StaticResource BehiPrimaryBrush}"/><Image Source="{Binding CurrentSong.Artwork}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=Choose a song}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=Ready to play}" FontSize="12" Foreground="{StaticResource BehiMutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel><Button x:Name="PlayPauseButton" Grid.Column="2" Click="PlayPause_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon x:Name="MiniPlayPauseIcon" Glyph="&#xE768;" FontSize="20"/></Button><Button Grid.Column="3" Click="OpenNowPlaying_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE70E;" FontSize="15"/></Button></Grid></Border>
                <Grid Grid.Row="2" Height="58" Background="{StaticResource BehiSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="HomeNavButton" Grid.Column="0" Tag="0" Click="Navigation_Click" Style="{StaticResource BehiNavButtonStyle}"><StackPanel><FontIcon Glyph="&#xE80F;" FontSize="18"/><TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="SongsNavButton" Grid.Column="1" Tag="1" Click="Navigation_Click" Style="{StaticResource BehiNavButtonStyle}"><StackPanel><FontIcon Glyph="&#xE8FD;" FontSize="18"/><TextBlock Text="Songs" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="AlbumsNavButton" Grid.Column="2" Tag="2" Click="Navigation_Click" Style="{StaticResource BehiNavButtonStyle}"><StackPanel><FontIcon Glyph="&#xE93C;" FontSize="18"/><TextBlock Text="Albums" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="ArtistsNavButton" Grid.Column="3" Tag="3" Click="Navigation_Click" Style="{StaticResource BehiNavButtonStyle}"><StackPanel><FontIcon Glyph="&#xE77B;" FontSize="18"/><TextBlock Text="Artists" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="MoreNavButton" Grid.Column="4" Tag="4" Click="Navigation_Click" Style="{StaticResource BehiNavButtonStyle}"><StackPanel><FontIcon Glyph="&#xE712;" FontSize="18"/><TextBlock Text="More" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Grid>
        </SplitView>

        <Grid x:Name="NowPlayingOverlay" Visibility="Collapsed" Background="{StaticResource ApplicationPageBackgroundThemeBrush}" ManipulationMode="TranslateY" ManipulationStarted="NowPlayingOverlay_ManipulationStarted" ManipulationDelta="NowPlayingOverlay_ManipulationDelta" ManipulationCompleted="NowPlayingOverlay_ManipulationCompleted">
            <Grid.RenderTransform><TranslateTransform x:Name="NowPlayingTransform"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Padding="10,10,12,6"><Button Width="44" HorizontalAlignment="Left" Click="CloseNowPlaying_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE72B;"/></Button><TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BehiMutedTextBrush}"/><Button Width="44" HorizontalAlignment="Right" Click="OpenQueue_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xEA37;"/></Button></Grid>
            <Grid Grid.Row="1"><StackPanel Padding="26,6,26,6" MaxWidth="520" VerticalAlignment="Center"><Border x:Name="NowPlayingArtwork" Width="200" Height="200" HorizontalAlignment="Center" CornerRadius="18" Background="{StaticResource BehiPrimaryContainerBrush}" Margin="0,0,0,16"><Grid><Ellipse Width="120" Height="120" Fill="{StaticResource BehiSurfaceRaisedBrush}"/><Ellipse Width="40" Height="40" Fill="{StaticResource BehiPrimaryBrush}"/><FontIcon Glyph="&#xE93C;" FontSize="38" Foreground="{StaticResource BehiPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18"/><Image Source="{Binding CurrentSong.Artwork}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=Choose a song}" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=Ready to play}" FontSize="14" Foreground="{StaticResource BehiMutedTextBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,12"/><Slider x:Name="PositionSlider" Minimum="0" Maximum="1" ValueChanged="PositionSlider_ValueChanged" Foreground="{StaticResource BehiPrimaryBrush}"/><Grid Margin="3,-3,3,0"><TextBlock x:Name="PositionText" Text="0:00" FontSize="11" Foreground="{StaticResource BehiMutedTextBrush}"/><TextBlock x:Name="DurationText" Text="0:00" FontSize="11" Foreground="{StaticResource BehiMutedTextBrush}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,10,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ShuffleButton" Grid.Column="0" Click="Shuffle_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;"/></Button><Button Grid.Column="1" Click="Previous_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE892;" FontSize="25"/></Button><Border Grid.Column="2" Width="52" Height="52" CornerRadius="26" Background="{StaticResource BehiPrimaryBrush}"><Button Click="PlayPause_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon x:Name="LargePlayPauseIcon" Glyph="&#xE768;" FontSize="23" Foreground="#FF201B2B"/></Button></Border><Button Grid.Column="3" Click="Next_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon Glyph="&#xE893;" FontSize="25"/></Button><Button x:Name="RepeatButton" Grid.Column="4" Click="Repeat_Click" Style="{StaticResource BehiIconButtonStyle}"><FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;"/></Button></Grid>
            </StackPanel></Grid>
            <Grid Grid.Row="2" Padding="22,5,22,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" HorizontalAlignment="Left" Click="OpenQueue_Click" Background="{StaticResource BehiSurfaceRaisedBrush}" BorderThickness="0" Margin="4"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xEA37;" Margin="0,0,8,0"/><TextBlock Text="Queue"/></StackPanel></Button><Button Grid.Column="1" HorizontalAlignment="Right" Background="{StaticResource BehiSurfaceRaisedBrush}" BorderThickness="0" Margin="4" IsEnabled="False"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE8D2;" Margin="0,0,8,0"/><TextBlock Text="Lyrics"/></StackPanel></Button></Grid>
        </Grid>

        <Border x:Name="ActionToast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,138" Padding="18,10" CornerRadius="18" Background="{StaticResource BehiPrimaryBrush}">
            <TextBlock x:Name="ActionToastText" Text="Added to queue" Foreground="#FF201B2B" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Page>
